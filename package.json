{
  "name": "dsh-whiteboard",
  "version": "0.5.0",
  "private": false,
  "description": "DSH 手写白板：历史白板列表 + 手写笔/铅笔/钢笔/毛笔/马克笔，三栏工具栏（工具 / 颜色·粗细·橡皮 / 操作）、单指平移、双指缩放、大橡皮拖动调整、检查更新与继续编辑。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "DinosaurYSL",
  "repository": {
    "type": "git",
    "url": "https://github.com/y1s2y3/dsh-whiteboard.git"
  },
  "homepage": "https://github.com/y1s2y3/dsh-whiteboard",
  "bugs": {
    "url": "https://github.com/y1s2y3/dsh-whiteboard/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "whiteboard",
    "handwriting",
    "canvas",
    "stylus",
    "手写白板"
  ]
}
